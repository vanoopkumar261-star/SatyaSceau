# Copy to backend/.env and edit. Never commit .env.

# Public URL phones use (cloudflared/ngrok URL during the demo). Used in the printed QR.
BASE_URL=http://localhost:8000

# Verdict engine
MATCH_WINDOW_MIN=5
RETENTION_DAYS=7

# OCR. Windows: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe  (leave empty if tesseract is on PATH)
TESSERACT_CMD=
OCR_MIN_CONF=60
MAX_UPLOAD_MB=8

# Ed25519 private key (relative paths are relative to backend/). Gitignored. Never commit it.
SIGNING_KEY_PATH=data/signing_key.pem

# SQLite file (default: backend/data/satyasceau.db)
# DATABASE_URL=sqlite:///data/satyasceau.db

# Off by default. Ask mentors before enabling (sends customer images to a third party).
ENABLE_EXTERNAL_AI=false

# Login (Supabase Auth only; app data stays in SQLite). From Supabase: Project Settings -> API Keys.
# Use the PUBLIC anon / publishable key, never the service_role / secret key.
# For the demo, turn OFF Authentication -> Sign In / Providers -> Email -> "Confirm email".
SUPABASE_URL=
SUPABASE_ANON_KEY=
